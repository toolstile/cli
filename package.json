{
  "name": "toolstile",
  "version": "0.4.0",
  "description": "Audit the MCP server configs your AI agents use for plaintext secrets, unpinned packages, auto-approved tools and duplicated setups, and connect those agents to Toolstile without putting tokens in their configs.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "audit",
    "claude",
    "cursor",
    "codex",
    "secrets",
    "mcp-proxy",
    "device-login"
  ],
  "homepage": "https://github.com/toolstile/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toolstile/cli.git"
  },
  "bugs": {
    "email": "support@toolstile.com"
  },
  "author": "Akshit Kr Nagpal <hello@akshit.io> (https://akshit.io)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "toolstile": "dist/cli.js"
  },
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
